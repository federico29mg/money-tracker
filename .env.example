# Copy this file to .env and set a strong password (8+ characters with upper case, lower case, digits and a symbol).
# Avoid ';' in the password: it is also used inside the services' connection strings.
MSSQL_SA_PASSWORD=
# Base64 PKCS#8 RSA private key for signing JWTs. Generate it with scripts/new-jwt-key.ps1 (Rider: Environment > New JWT signing key).
JWT_SIGNING_KEY=